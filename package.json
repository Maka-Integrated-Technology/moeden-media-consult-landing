    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "morgan": "1.12.1",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
